<resources>
    <style name="Theme.Sunnyside" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sunny_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Sunnyside.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sunny_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Sunnyside</item>
    </style>
</resources>
